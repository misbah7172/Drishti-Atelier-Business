# ========================================================
# Drishti Atelier — Backend Server Environment Variables
# Copy this file to .env and replace placeholders with real values
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon Tech)
DATABASE_URL=postgresql://username:password@localhost:5432/drishti_db?sslmode=require

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000
