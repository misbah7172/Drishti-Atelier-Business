# ========================================================
# Drishti Atelier — Client Environment Variables
# Copy this file to .env and replace placeholders with real values
# ========================================================

# Backend API Endpoint
# Local development: http://localhost:5000/api
# Production (Vercel): https://your-backend-api.vercel.app/api or /api
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Web client ID matching your authorized JavaScript origins (http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
