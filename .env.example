# ========================================================
# Drishti Atelier — Root Environment Variables Template
# Copy this file to .env for local development
# ========================================================

PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL Pooled Connection)
DATABASE_URL=postgresql://username:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Firebase Authentication
FIREBASE_PROJECT_ID=drishti-7172

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
